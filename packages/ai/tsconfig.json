{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    /* NodeNext is why imports end in .js even though the files are .ts —
       that is the ESM rule, not a mistake. The engine package uses
       Bundler resolution; both work, and each package keeps its own. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
