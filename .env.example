# Copy to apps/server/.env (never commit the real one).

# --- Person A: server ---
PORT=3000
HOST=0.0.0.0
DB_PATH=rugbygrid.db
# Load seed/fresh.json on boot if the DB is empty
SEED_ON_BOOT=true
# Display pacing between constraint agent:events (the solve itself takes ~10 ms)
TRACE_PACE_MS=80
# Hard cap on how long one paced trace may take on screen
TRACE_MAX_MS=6000
LOG_LEVEL=info

# --- Person C: AI (live | mock). Build and rehearse in mock: free tier is 20 requests/DAY. ---
AI_MODE=mock
GEMINI_API_KEY=
# Model IDs verified by C on 2026-09-29 (see packages/ai/NOTES.md #2-3)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
AI_TIMEOUT_MS=12000
